# Signs access cookies and restore links. Any long random string: `openssl rand -hex 32`
ACCESS_SECRET=

# "paid" (default) or "open" — open unlocks everything (useful for preview deployments)
ACCESS_MODE=paid

# Your site's public URL, used in Stripe and email links
NEXT_PUBLIC_SITE_URL=https://theeventsguy.co.uk

# Stripe — a recurring Price for the subscription
STRIPE_SECRET_KEY=
# Two recurring prices on one Stripe product
STRIPE_PRICE_QUARTERLY=price_...
STRIPE_PRICE_YEARLY=price_...
NEXT_PUBLIC_PRICE_QUARTERLY=£45
NEXT_PUBLIC_PRICE_YEARLY=£150
NEXT_PUBLIC_YEARLY_SAVING=Billed once a year — save £30.

# Preview gate (fails closed: the site is locked until these are set, or SITE_PUBLIC=true)
SITE_USERNAME=
SITE_PASSWORD=
# SITE_PUBLIC=true

# Restore-access emails (Resend). Without these, restore links are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM=The Events Guy <access@theeventsguy.co.uk>

# Where Services and Sponsors enquiries are emailed (needs RESEND_API_KEY + EMAIL_FROM)
ENQUIRIES_TO=hello@theeventsguy.co.uk
